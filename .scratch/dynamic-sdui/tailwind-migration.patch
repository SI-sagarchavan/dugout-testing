+/**
+ * The stylesheet for a render, compiled by Tailwind from the classes it uses.
+ *
+ * Every style the renderer draws is a Tailwind utility, and most are built from
+ * the tree at render time (`p-md`, `w-[182px]`, `md:flex-row`). A build that
+ * scans source files never sees those, so the CSS is compiled per render: the
+ * classes in the markup, against the tenant's theme. Tailwind's own `compile`
+ * needs no file access, so this runs wherever the renderer does: the harness,
+ * Studio's preview, a Next.js server component.
+ *
+ * Interactive primitives never add or remove classes on the client. State is an
+ * attribute (`data-state`, `aria-disabled`) read by a variant
+ * (`data-[state=active]:…`), so every class an element can ever carry is in the
+ * server markup, and this stylesheet already has it.
+ *
+ * No Tailwind default theme and no preflight: only the tokens' `@theme` exists,
+ * so a utility that names no token produces no CSS rather than a Tailwind
+ * default, and nothing restyles the page beyond what the tree asked for.
+ */
+
+import { Fragment, isValidElement, type ReactNode } from "react";
+import { compile } from "tailwindcss";
+
+/**
+ * What the renderer itself declares, before the tenant's stylesheet.
+ *
+ * The breakpoints are the defaults (`@fanos/tokens` DEFAULT_BREAKPOINTS); the
+ * tenant's `@theme`, emitted by `emitCss`, restates them. `--spacing-0` lets the
+ * zero utilities (`inset-0`, `m-0`, `min-w-0`) resolve without the default
+ * spacing scale.
+ */
+export const RENDERER_CSS = `@theme {
+  --breakpoint-md: 768px;
+  --breakpoint-lg: 1280px;
+  --spacing-0: 0px;
+}
+`;
+
+export interface CompileCssOptions {
+  /**
+   * The tenant's stylesheet: `emitCss(theme, { surfaces }).css` from
+   * `@fanos/tokens` (token vars, `@theme`, the `type-*` and `surface-*`
+   * utilities), plus any plain CSS a caller appends.
+   */
+  themeCss: string;
+  /** The classes to generate CSS for. `classesIn(markup)` collects them from a render. */
+  classes: Iterable<string>;
+}
+
+/** Compile the stylesheet for exactly these classes. */
+export async function compileCss({ themeCss, classes }: CompileCssOptions): Promise<string> {
+  const compiler = await compile(`${RENDERER_CSS}\n${themeCss}\n@tailwind utilities;\n`);
+  return compiler.build([...new Set(classes)]);
+}
+
+/** Compile the stylesheet for a rendered page: every class its markup uses. */
+export async function cssForMarkup(markup: string, themeCss: string): Promise<string> {
+  return compileCss({ themeCss, classes: classesIn(markup) });
+}
+
+const ENTITIES: Record<string, string> = { "&amp;": "&", "&quot;": '"', "&#x27;": "'", "&#39;": "'", "&lt;": "<", "&gt;": ">" };
+
+/** Every class token in an HTML string's `class` attributes, entities decoded. */
+export function classesIn(markup: string): string[] {
+  const out = new Set<string>();
+  for (const match of markup.matchAll(/\sclass="([^"]*)"/g)) {
+    const value = match[1]!.replace(/&(?:amp|quot|#x27|#39|lt|gt);/g, (e) => ENTITIES[e]!);
+    for (const token of value.split(/\s+/)) if (token) out.add(token);
+  }
+  return [...out];
+}
+
+/**
+ * Every class a React element tree will render, without rendering it to HTML.
+ *
+ * For hosts that cannot use `react-dom/server` — a Next.js Server Component,
+ * which refuses it. Walks the elements, calling each server component as React
+ * would (they are pure functions of their props: no hooks, no async), and
+ * collects `className` from every DOM element.
+ *
+ * A client component is NOT called — its hooks need React. So a client
+ * component never owns a class string: the server side passes every class it
+ * can carry as props (`className`, `*ClassName`, or a `classNames` object), and
+ * this collects those props.
+ */
+export function classesOfElement(root: ReactNode): string[] {
+  const out = new Set<string>();
+  const add = (value: unknown) => {
+    if (typeof value === "string") for (const t of value.split(/\s+/)) if (t) out.add(t);
+  };
+  const visit = (node: ReactNode): void => {
+    if (node === null || node === undefined || typeof node === "boolean") return;
+    if (typeof node === "string" || typeof node === "number") return;
