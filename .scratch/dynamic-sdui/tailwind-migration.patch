-  --p-base: initial;   --p-md: initial;   --p-lg: initial;
-  --px-base: initial;  --px-md: initial;  --px-lg: initial;
-  --py-base: initial;  --py-md: initial;  --py-lg: initial;
-  --pt-base: initial;  --pt-md: initial;  --pt-lg: initial;
