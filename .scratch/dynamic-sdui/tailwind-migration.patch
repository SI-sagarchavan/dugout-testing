@@ -0,0 +1,61 @@
+/**
+ * What a set of Tailwind classes actually declares, as the inline style the
+ * renderer used to write.
+ *
+ * The migration to Tailwind must not move a pixel, so the strongest test is not
+ * "these class names come out" but "these classes compile to the declarations
+ * the inline style had". This compiles the classes against a theme whose spacing
+ * keys point at the token vars (as `@fanos/tokens` emits it), merges every
+ * declaration, and normalises Tailwind's spelling back to the old one:
+ *
+ *   var(--spacing-4)              → var(--fos-space-4)
+ *   calc(var(--spacing-6) * -1)   → calc(-1 * var(--fos-space-6))
+ *   calc(1/2 * 100%)              → 50%
+ *   the translate custom props    → transform: translate(…)
+ */
+
+import { compileCss } from "../src/css.js";
+
+const SPACE_KEYS = ["1", "2", "4", "5", "6", "9"];
+
+const THEME = `@theme {\n${SPACE_KEYS.map((k) => `  --spacing-${k}: var(--fos-space-${k});`).join("\n")}\n}\n`;
+
+function normalise(value: string): string {
+  return value
+    .trim()
+    .replace(/calc\(var\(--spacing-([\w-]+)\) \* -1\)/g, "calc(-1 * var(--fos-space-$1))")
+    .replace(/var\(--spacing-0\)/g, "0")
+    .replace(/var\(--spacing-([\w-]+)\)/g, "var(--fos-space-$1)")
+    .replace(/calc\(1\s*\/\s*2 \* 100%\)/g, "50%");
+}
+
+/** The declarations of these classes, keyed in camelCase like a React style object. */
+export async function declarationsOf(classes: string[]): Promise<Record<string, string>> {
+  const css = await compileCss({ themeCss: THEME, classes });
+  const out: Record<string, string> = {};
+  let tx: string | undefined;
+  let ty: string | undefined;
+  const rules = css.replace(/\/\*[\s\S]*?\*\//g, "");
+  for (const [, selector, body] of rules.matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
+    // A statement such as `@layer properties;` can precede a rule in the same match.
+    if (!selector!.split(";").pop()!.trim().startsWith(".")) continue;
+    for (const decl of body!.split(";")) {
+      const i = decl.indexOf(":");
+      if (i < 0) continue;
+      const prop = decl.slice(0, i).trim();
+      const value = normalise(decl.slice(i + 1));
+      if (prop === "--tw-translate-x") tx = value;
+      else if (prop === "--tw-translate-y") ty = value;
+      else if (prop === "translate" || prop.startsWith("--tw-")) continue;
+      else out[prop.replace(/-([a-z])/g, (_m, c: string) => c.toUpperCase())] = value === "0px" ? "0" : value;
+    }
+  }
+  const half = (v: string | undefined) => (v && /-?\s*50%|calc\(50% \* -1\)/.test(v) ? "-50%" : undefined);
+  const x = half(tx);
+  const y = half(ty);
+  if (x && y) out.transform = "translate(-50%, -50%)";
+  else if (x) out.transform = "translateX(-50%)";
+  else if (y) out.transform = "translateY(-50%)";
+  return out;
+}
+
