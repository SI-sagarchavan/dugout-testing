{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cardId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$"
    },
    "nodeCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rootType": {
      "type": "string",
      "enum": [
        "Box",
        "Stack",
        "Overlay",
        "Text",
        "Image",
        "Icon",
        "Divider",
        "Button"
      ]
    }
  },
  "required": [
    "cardId",
    "nodeCount",
    "rootType"
  ],
  "additionalProperties": false
}
