{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "previewUrl": {
      "type": "string"
    },
    "treeArtifactId": {
      "type": "string"
    },
    "measured": {
      "type": "boolean",
      "description": "False when too little of the frame has a screenshot to compare"
    },
    "coverage": {
      "type": "number",
      "description": "Share of the frame a compared screenshot covers, 0 to 100"
    },
    "estimated": {
      "type": "boolean",
      "description": "A screenshot had padding of unknown side and was placed by search"
    },
    "unchecked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Layers on show that no compared screenshot holds"
    },
    "placeholderIcons": {
      "type": "number",
      "description": "Icons on show with no art"
    },
    "before": {
      "description": "Match before this run, 0 to 100",
      "type": "number"
    },
    "match": {
      "description": "Match of the published frame, 0 to 100",
      "type": "number"
    },
    "unmeasuredBecause": {
      "description": "Why nothing could be compared",
      "type": "string"
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What still differs and why, stand-ins and raw values"
    },
    "compilerFindings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the compiler should have done"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the designer's note, as frame.load listed it"
          },
          "status": {
            "type": "string",
            "enum": [
              "addressed",
              "not-addressed",
              "not-mine"
            ],
            "description": "addressed: done, and detail says how. not-addressed: not done, and detail says why. not-mine: the note is about where data comes from or what it shows, which the next stage (data-bind) decides"
          },
          "detail": {
            "type": "string",
            "description": "What was done, or why not"
          }
        },
        "required": [
          "id",
          "status",
          "detail"
        ],
        "additionalProperties": false
      },
      "description": "One entry for each note the designer left (frame.load lists them): met, or why not. [] when it listed none"
    },
    "content": {
      "description": "Whether anything on the section is data: none means there is nothing to bind",
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "enum": [
            "none",
            "some",
            "unsure"
          ],
          "description": "none: nothing on it is data, so nothing is bound; some: it shows data; unsure: the signs do not say"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What says so, each one sign"
        }
      },
      "required": [
        "data",
        "evidence"
      ],
      "additionalProperties": false
    },
    "choices": {
      "description": "What the section's tabs write to its page (_page.<key>), for other sections to read",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          },
          "initial": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "options",
          "initial"
        ],
        "additionalProperties": false
      }
    },
    "slots": {
      "description": "The parts of the frame that each show one kind of data, with the tree nodes each owns, whether it shows data, and the page keys it writes and reads",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Its heading, slugged: the-brave-squad"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The tree's node ids it owns"
          },
          "content": {
            "type": "object",
            "properties": {
              "data": {
                "type": "string",
                "enum": [
                  "none",
                  "some",
                  "unsure"
                ],
                "description": "none: nothing on it is data, so nothing is bound; some: it shows data; unsure: the signs do not say"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "What says so, each one sign"
              }
            },
            "required": [
              "data",
              "evidence"
            ],
            "additionalProperties": false
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The page keys its tabs write"
          },
          "reads": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The page keys its nodes read"
          },
          "signature": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "sure",
              "unsure"
            ]
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "nodes",
          "content",
          "writes",
          "reads",
          "signature",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "previewUrl",
    "treeArtifactId",
    "measured",
    "coverage",
    "estimated",
    "unchecked",
    "placeholderIcons",
    "remaining",
    "compilerFindings",
    "notes"
  ],
  "additionalProperties": false
}
