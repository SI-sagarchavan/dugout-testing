{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "previewUrl": {
      "type": "string",
      "description": "The preview with its data bound: the one thing handed over"
    },
    "treeArtifactId": {
      "type": "string"
    },
    "planArtifactId": {
      "type": "string",
      "description": "Empty when nothing was bound"
    },
    "dataArtifactId": {
      "type": "string",
      "description": "Empty when nothing was bound"
    },
    "data": {
      "default": "bound",
      "description": "stand-in: bound to data about something else than the design (another team), see dataWhy; none: nothing was bound, so it was handed over as designed",
      "type": "string",
      "enum": [
        "bound",
        "stand-in",
        "none"
      ]
    },
    "dataWhy": {
      "default": [],
      "description": "Why the section was read as showing no data",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "choices": {
      "default": [],
      "description": "What the section's tabs write to its page (_page.<key>), for other sections to read",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          },
          "initial": {
            "type": "string"
          },
          "owner": {
            "description": "The slot that draws it",
            "type": "string"
          }
        },
        "required": [
          "key",
          "options",
          "initial"
        ],
        "additionalProperties": false
      }
    },
    "slots": {
      "default": [],
      "description": "Each part of the frame that shows one kind of data, and what became of it",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The slot's heading, slugged"
          },
          "data": {
            "type": "string",
            "enum": [
              "bound",
              "stand-in",
              "none",
              "failed",
              "skipped"
            ],
            "description": "stand-in: bound to data about something else (another team), shown for the shape; none: nothing in it is data, or no data could be had and the design's copy stays; failed: it could not be bound; skipped: a person chose not to bind it in this pass, for Cast's live-run budget"
          },
          "hookId": {
            "description": "The Cast hook its data comes from",
            "type": "string"
          },
          "dataWhy": {
            "description": "Why the slot is a stand-in, or why nothing was bound (code's reading)",
            "type": "string"
          },
          "bound": {
            "type": "number"
          },
          "collapsed": {
            "type": "number"
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "data",
          "bound",
          "collapsed",
          "remaining"
        ],
        "additionalProperties": false
      }
    },
    "measured": {
      "type": "boolean",
      "description": "False when too little of the frame has a screenshot to compare"
    },
    "coverage": {
      "type": "number",
      "description": "Share of the frame a compared screenshot covers, 0 to 100"
    },
    "before": {
      "description": "Match before the frame was fixed, 0 to 100",
      "type": "number"
    },
    "match": {
      "description": "Match of the published frame, 0 to 100",
      "type": "number"
    },
    "bound": {
      "type": "number",
      "description": "Props bound to data"
    },
    "collapsed": {
      "type": "number",
      "description": "Lists the binding made"
    },
    "created": {
      "default": [],
      "description": "What the pass created in Cast that other hooks and people can use (providers, connectors), for a person to see",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settled": {
      "default": [],
      "description": "How each open item page.build reported was settled, and by whom",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "enum": [
              "person",
              "memory",
              "agent"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "by",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Everything still off, each starting with the part it is about: frame or data"
    },
    "kept": {
      "default": [],
      "description": "What the binding left as designed on purpose, with why: the section's static parts, a look the data does not decide",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compilerFindings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the compiler should have done"
    },
    "notes": {
      "default": [],
      "description": "Each note the designer left: addressed by one of the stages, or why not",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "addressed",
              "not-addressed"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "previewUrl",
    "treeArtifactId",
    "planArtifactId",
    "dataArtifactId",
    "data",
    "dataWhy",
    "choices",
    "slots",
    "measured",
    "coverage",
    "bound",
    "collapsed",
    "created",
    "settled",
    "remaining",
    "kept",
    "compilerFindings",
    "notes"
  ],
  "additionalProperties": false
}
