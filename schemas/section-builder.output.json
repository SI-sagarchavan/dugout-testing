{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "previewUrl": {
      "type": "string",
      "description": "The preview with its data bound: the one thing handed over"
    },
    "treeArtifactId": {
      "type": "string"
    },
    "planArtifactId": {
      "type": "string",
      "description": "Empty when nothing was bound"
    },
    "dataArtifactId": {
      "type": "string",
      "description": "Empty when nothing was bound"
    },
    "data": {
      "default": "bound",
      "description": "none: nothing on the section is data, so it was handed over with nothing bound",
      "type": "string",
      "enum": [
        "bound",
        "none"
      ]
    },
    "dataWhy": {
      "default": [],
      "description": "Why the section was read as showing no data",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "choices": {
      "default": [],
      "description": "What the section's tabs write to its page (_page.<key>), for other sections to read",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          },
          "initial": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "options",
          "initial"
        ],
        "additionalProperties": false
      }
    },
    "measured": {
      "type": "boolean",
      "description": "False when too little of the frame has a screenshot to compare"
    },
    "coverage": {
      "type": "number",
      "description": "Share of the frame a compared screenshot covers, 0 to 100"
    },
    "before": {
      "description": "Match before the frame was fixed, 0 to 100",
      "type": "number"
    },
    "match": {
      "description": "Match of the published frame, 0 to 100",
      "type": "number"
    },
    "bound": {
      "type": "number",
      "description": "Props bound to data"
    },
    "collapsed": {
      "type": "number",
      "description": "Lists the binding made"
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Everything still off, each starting with the part it is about: frame or data"
    },
    "compilerFindings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the compiler should have done"
    },
    "notes": {
      "default": [],
      "description": "Each note the designer left: addressed by one of the stages, or why not",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "addressed",
              "not-addressed"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "previewUrl",
    "treeArtifactId",
    "planArtifactId",
    "dataArtifactId",
    "data",
    "dataWhy",
    "choices",
    "measured",
    "coverage",
    "bound",
    "collapsed",
    "remaining",
    "compilerFindings",
    "notes"
  ],
  "additionalProperties": false
}
