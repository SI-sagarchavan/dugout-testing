{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z]-\\d{3}$",
      "description": "Fixture id, for example c-101"
    },
    "brief": {
      "description": "What to emphasise",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "channels": {
      "description": "Extra pieces: social, push or headline",
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "social",
          "push",
          "headline"
        ]
      }
    }
  },
  "required": [
    "fixtureId"
  ]
}
