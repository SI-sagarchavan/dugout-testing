{
  "name": "dugout",
  "version": "0.0.0",
  "private": true,
  "description": "Dugout \u2014 FanOS agent harness, agents and evals",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "seed": "tsx packages/sdk/scripts/seed.ts",
    "schemas": "tsx packages/sdk/scripts/schemas.ts",
    "agent": "tsx apps/cli/scripts/agent.ts",
    "preview": "tsx apps/cli/scripts/agent.ts match-preview",
    "sitemap": "tsx apps/cli/scripts/agent.ts sitemap",
    "matchday": "tsx apps/cli/scripts/agent.ts matchday",
    "card": "tsx agents/card/scripts/card.ts",
    "card-match:measure": "tsx agents/card-match/scripts/measure.ts",
    "card:watch": "tsx apps/cli/scripts/figma-watch.ts",
    "round": "tsx agents/round/scripts/round.ts",
    "memory:review": "tsx packages/memory/scripts/review.ts",
    "memory:promote": "tsx packages/memory/scripts/promote.ts",
    "eval": "tsx packages/evals/scripts/eval.ts",
    "worker": "tsx apps/worker/scripts/work.ts",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "smoke": "tsx packages/core/scripts/smoke.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "card-match:vision": "tsx agents/card-match/scripts/vision-bench.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
