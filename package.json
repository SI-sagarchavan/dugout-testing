{
  "name": "dugout",
  "version": "0.0.0",
  "private": true,
  "description": "Dugout — FanOS agent harness, agents and evals",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "agent": "tsx scripts/agent.ts",
    "worker": "tsx apps/worker/scripts/work.ts",
    "eval": "tsx scripts/eval.ts",
    "db": "tsx scripts/db.ts",
    "infra": "scripts/infra.sh",
    "dev": "pnpm --parallel --filter @fanos/api run \"/^dev(:worker)?$/\"",
    "build": "pnpm --filter \"@fanos/*\" -r build",
    "fixture": "tsx apps/worker/scripts/fixture.ts",
    "scre:sync": "tsx scripts/scre-sync.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
