# Models: Amazon Bedrock (ADR 0012). No API key, and never put AWS access keys here: credentials come
# from the AWS SDK's default chain (a profile in ~/.aws locally, the task role on ECS). The region
# is AWS_REGION, then the profile's region, then ap-south-1.
# AWS_PROFILE=si-main
# AWS_REGION=ap-south-1
# Which model each agent runs on is a name in config/models.json, set in its spec (ADR 0015).

# Embeddings for memory search, 1024 dimensions. EMBEDDING_PROVIDER=bedrock uses Titan Text
# Embeddings V2 (amazon.titan-embed-text-v2:0) with the AWS credentials and region above. Otherwise
# EMBEDDING_BASE_URL selects any OpenAI-compatible /embeddings endpoint; with neither, the built-in
# word-hashing embedder (lexical matching only). After changing the embedder run
# `pnpm agent memory embed`: it embeds again every row another embedder made (ADR 0034).
# The section library's words and pictures (`library_sections`) use Amazon Nova Multimodal
# Embeddings (amazon.nova-2-multimodal-embeddings-v1:0, 1024 dimensions) with the same
# EMBEDDING_PROVIDER=bedrock; unset, the hash embedder. The model is not in ap-south-1: it is called
# in us-east-1 unless NOVA_EMBEDDING_REGION says otherwise. After changing it run
# `pnpm agent library reembed`.
EMBEDDING_PROVIDER=bedrock
# NOVA_EMBEDDING_REGION=us-east-1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# The model `pnpm agent memory promote` uses to rewrite tenants' facts and lessons as shared memory
# (ADR 0014), a name in config/models.json; empty uses sonnet-india (Claude Sonnet 5 on the India
# profile), which keeps tenant data in India. It is an offline job, so its cost is not counted
# against any run's budget.
MEMORY_PROMOTE_MODEL=

# docker compose services (ports offset to avoid a local Postgres/Redis). The app connects as the
# non-superuser dugout_app role so row-level security applies; migrations use the admin role.
DATABASE_URL=postgres://dugout_app:dugout_app@localhost:55432/harness
DATABASE_ADMIN_URL=postgres://harness:harness@localhost:55432/harness
VALKEY_URL=redis://localhost:56379
# A namespace for the run stream keys on a shared cluster, e.g. fanos:dev:dugout:
VALKEY_KEY_PREFIX=

# Worker (pnpm worker), all optional: the agents it runs (default all), runs at once, how often it
# looks for runs, and how long runs get to finish on SIGTERM before they're handed over
AGENTS=
WORKER_CONCURRENCY=10
WORKER_POLL_MS=1000
WORKER_GRACE_MS=20000

# Langfuse tracing: off unless both keys are set
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# production, staging or development (the default): keeps test traces out of production views
LANGFUSE_TRACING_ENVIRONMENT=

# Cast MCP (ADR 0022): the endpoint, and where each tenant's login is kept (default .runs/cast-mcp.json).
# Log in once per tenant: pnpm --filter @dugout/mcp cast:login --tenant <id> --site <code>
CAST_MCP_URL=
CAST_MCP_TOKENS=
# Or use the sign-in a person made in Surface Studio's Setup page (MCP servers > Connect): the backend keeps it.
# Set both. The tenant id is then the FanXP client code. SURFACE_API_URL ends in /api/v1; the key is the backend's SURFACE_SERVICE_KEY.
SURFACE_API_URL=
SURFACE_SERVICE_KEY=

# The section library's search over HTTP (`pnpm agent library serve`, :4200): the service
# wnm-fanxp-backend calls for Surface Studio's Library. With a key every /api call needs
# `Authorization: Bearer <key>` and `x-tenant: <client code>` and there is no page; without one it is
# a local search page for trying it (keep it on 127.0.0.1). Put the same key in the backend's .env
# (LIBRARY_SERVICE_URL, LIBRARY_SERVICE_KEY).
# LIBRARY_SERVICE_KEY=<openssl-rand-hex-24>
