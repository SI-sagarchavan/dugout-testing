# Model access: any OpenAI-compatible Chat Completions provider (ADR 0001). Defaults target DeepSeek.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_SMART=deepseek-flash

# Embeddings for memory search: any OpenAI-compatible /embeddings endpoint returning 1024 dimensions.
# Leave EMBEDDING_BASE_URL empty to use the built-in word-hashing embedder (lexical matching only).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# docker compose services (ports offset to avoid a local Postgres/Redis). The app connects as the
# non-superuser dugout_app role so row-level security applies; migrations use the admin role.
DATABASE_URL=postgres://dugout_app:dugout_app@localhost:55432/harness
DATABASE_ADMIN_URL=postgres://harness:harness@localhost:55432/harness
VALKEY_URL=redis://localhost:56379

# API: HS256 secret for local dev tokens (pnpm token). FanOS auth replaces this later.
DUGOUT_JWT_SECRET=
PORT=8787

# Langfuse tracing: off unless both keys are set
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
