{
  "id": "cast",
  "title": "Cast",
  "description": "Cast hooks (workflows): API connectors wired into a graph, shaped by a JSONata transform into the data a page reads.",
  "owner": "cast-team",
  "environment": "dev",
  "transport": {
    "type": "streamable-http",
    "url": {
      "env": "CAST_MCP_URL"
    }
  },
  "auth": {
    "type": "oauth-per-tenant",
    "grants": {
      "env": "CAST_MCP_TOKENS",
      "default": ".runs/cast-mcp.json"
    },
    "scope": "cast:mcp",
    "surface": {
      "url": {
        "env": "SURFACE_API_URL"
      },
      "key": {
        "env": "SURFACE_SERVICE_KEY"
      }
    }
  },
  "headers": {
    "client": "{grant.site}"
  },
  "adapter": "cast",
  "tools": {
    "cast_list_hooks": {
      "effect": "read",
      "retries": 1
    },
    "cast_describe_hook": {
      "effect": "read",
      "retries": 1
    },
    "cast_list_apis": {
      "effect": "read",
      "retries": 1
    },
    "cast_describe_api": {
      "effect": "read",
      "retries": 1
    },
    "cast_list_providers": {
      "effect": "read",
      "retries": 1
    },
    "cast_get_template_binding": {
      "effect": "read",
      "retries": 1
    },
    "cast_list_versions": {
      "effect": "read",
      "retries": 1
    },
    "cast_lint_hook": {
      "effect": "read",
      "retries": 1
    },
    "cast_eval_jsonata": {
      "effect": "read",
      "retries": 1
    },
    "cast_run_hook": {
      "effect": "read",
      "reason": "It calls the hook's partner APIs for real. The readOnlyHook guard runs it only for a hook whose connectors all GET and that calls no other hook (cast_describe_hook's readOnly), so a run changes no partner data; it spends partner quota and the server's run budget, so it is not retried.",
      "guard": "readOnlyHook",
      "timeoutMs": 90000
    },
    "cast_fetch_sample": {
      "effect": "read",
      "timeoutMs": 90000
    },
    "cast_validate": {
      "effect": "read",
      "timeoutMs": 90000
    },
    "cast_create_hook": {
      "effect": "write"
    },
    "cast_update_hook": {
      "effect": "write"
    },
    "cast_add_step": {
      "effect": "write"
    },
    "cast_update_step": {
      "effect": "write"
    },
    "cast_remove_step": {
      "effect": "write",
      "shared": false
    },
    "cast_wire_steps": {
      "effect": "write"
    },
    "cast_set_transform": {
      "effect": "write"
    },
    "cast_publish_hook": {
      "effect": "write",
      "timeoutMs": 60000
    },
    "cast_upsert_provider": {
      "effect": "write",
      "shared": true
    },
    "cast_upsert_api": {
      "effect": "write",
      "shared": true
    }
  },
  "capabilities": {
    "hooks.read": {
      "description": "Read every hook and connector: what feeds a template, what a hook gives.",
      "tools": {
        "cast_list_hooks": {},
        "cast_describe_hook": {},
        "cast_list_apis": {},
        "cast_describe_api": {},
        "cast_get_template_binding": {}
      }
    },
    "hooks.author": {
      "description": "Build and publish hooks in dugout's namespace (dugout_). Any hook may be read, to copy what it passes a connector; only dugout_ hooks are written or run.",
      "tools": {
        "cast_list_apis": {},
        "cast_describe_api": {},
        "cast_fetch_sample": {},
        "cast_describe_hook": {},
        "cast_list_hooks": {
          "set": {
            "idPrefix": "dugout_"
          }
        },
        "cast_eval_jsonata": {},
        "cast_create_hook": {
          "arguments": {
            "id": "^dugout_[a-z0-9_]+$",
            "name": "^dugout: "
          }
        },
        "cast_update_hook": {
          "arguments": {
            "hookId": "^dugout_",
            "name": "^dugout: "
          }
        },
        "cast_add_step": {
          "arguments": {
            "hookId": "^dugout_"
          }
        },
        "cast_update_step": {
          "arguments": {
            "hookId": "^dugout_"
          }
        },
        "cast_remove_step": {
          "arguments": {
            "hookId": "^dugout_"
          }
        },
        "cast_wire_steps": {
          "arguments": {
            "hookId": "^dugout_"
          }
        },
        "cast_set_transform": {
          "arguments": {
            "hookId": "^dugout_"
          }
        },
        "cast_lint_hook": {
          "arguments": {
            "hookId": "^dugout_"
          }
        },
        "cast_run_hook": {
          "arguments": {
            "hookId": "^dugout_"
          }
        },
        "cast_validate": {
          "arguments": {
            "hookId": "^dugout_"
          }
        },
        "cast_publish_hook": {
          "arguments": {
            "hookId": "^dugout_"
          }
        }
      },
      "resources": ["cast://examples/hooks", "cast://guide/jsonata"]
    },
    "connectors.author": {
      "description": "Create API connectors and their providers in dugout's namespace (names start \"dugout: \"), so a feed a person gave can be called by a hook. Create only: a connector or provider is shared by every hook that calls it, so an update, which names an id, is refused. Any provider may be read, to reuse one.",
      "tools": {
        "cast_list_providers": {},
        "cast_list_apis": {},
        "cast_describe_api": {},
        "cast_upsert_provider": {
          "absent": ["id"],
          "arguments": {
            "name": "^dugout: "
          }
        },
        "cast_upsert_api": {
          "absent": ["id"],
          "arguments": {
            "name": "^dugout: "
          }
        }
      }
    }
  }
}
